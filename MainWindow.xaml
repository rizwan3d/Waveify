<ui:FluentWindow x:Class="Waveify.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="Waveify" Width="1660" Height="900" MinWidth="1250" MinHeight="730"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
 Background="{StaticResource WaveAppBg}" Foreground="White">
    <Border Margin="7" CornerRadius="18" Background="{StaticResource WaveShell}" BorderBrush="#202633" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>

            <!-- top bar -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                <Grid Margin="14,10,14,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="▥" Foreground="{StaticResource WaveAccent}" FontWeight="Black" FontSize="30" Margin="0,0,9,0" VerticalAlignment="Center"/>
                         <TextBlock Text="waveify" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="1" Width="350" Height="39" CornerRadius="20" Background="#202530" BorderBrush="#2B3040" BorderThickness="1" HorizontalAlignment="Left">
                        <DockPanel Margin="12,0">
                            <ui:SymbolIcon Symbol="Search24" Foreground="#8792A7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Background="Transparent" BorderThickness="0" Foreground="#F2F5FB" VerticalContentAlignment="Center" FontSize="13" ToolTip="Search offline music, YouTube, SoundCloud and Spotify"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource CircleTopButton}" ToolTip="Batch import" Click="BatchImport_Click"><ui:SymbolIcon Symbol="ArrowDownload24"/></Button>
                        <Button Style="{StaticResource CircleTopButton}" ToolTip="Setup tools" Click="SetupTools_Click"><ui:SymbolIcon Symbol="Settings24"/></Button>
                        <Button Style="{StaticResource CircleTopButton}" ToolTip="Toggle equalizer" Click="ToggleEqualizer_Click"><ui:SymbolIcon Symbol="Settings24"/></Button>
                        <Button Style="{StaticResource CircleTopButton}" ToolTip="Import link" Click="ImportLink_Click"><ui:SymbolIcon Symbol="Link24"/></Button>
                        <Border Width="1" Height="20" Background="#2A3345" Margin="10,0"/>
                        <Button Style="{StaticResource FlatNavButton}" Click="WindowMinimize_Click" Content="—" FontSize="16"/>
                        <Button x:Name="MaxRestoreButton" Style="{StaticResource FlatNavButton}" Click="WindowMaxRestore_Click" Content="□" FontSize="11"/>
                        <Button Style="{StaticResource FlatNavButton}" Click="WindowClose_Click" Content="✕" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="10,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- left sidebar -->
                <Border Grid.Column="0" Margin="0,0,14,0" Background="{StaticResource WavePanel}" BorderBrush="{StaticResource WaveStroke}" BorderThickness="1" CornerRadius="16" Padding="12">
                    <ScrollViewer x:Name="SidebarScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  PreviewMouseWheel="SidebarScrollViewer_PreviewMouseWheel">
                        <StackPanel>
                        <Grid Margin="0,2,0,12">
                             <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                             <Border Width="52" Height="52" CornerRadius="26" Background="#242936" HorizontalAlignment="Left">
                                 <ui:SymbolIcon Symbol="MusicNote224" Foreground="#36E2A2" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                             </Border>
                             <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                 <TextBlock Text="Your library" FontSize="15" FontWeight="Bold" Margin="0,0,0,4"/>
                                 <TextBlock Text="Offline music" FontSize="11" Foreground="{StaticResource WaveMuted}"/>
                             </StackPanel>
                         </Grid>

                        <StackPanel Margin="0,12,0,0">
                            <Button x:Name="HomeNavButton" Style="{StaticResource SidebarActiveButton}" Click="Home_Click">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Home24" Margin="0,0,12,0"/><TextBlock Text="Home"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarNew}" Click="Liked_Click">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Heart24" Margin="0,0,12,0"/><TextBlock Text="Liked"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarNew}" Click="CreatePlaylist_Click">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" Margin="0,0,12,0"/><TextBlock Text="New playlist"/></StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="Library" Foreground="{StaticResource WaveMuted}" FontSize="12" Margin="8,0,0,8"/>
                            <Button Style="{StaticResource SidebarNew}" Click="RescanLibrary_Click" ToolTip="Rescan music folders for unlisted songs">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,12,0"/><TextBlock Text="Rescan library"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarNew}" Click="AddFiles_Click">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" Margin="0,0,12,0"/><TextBlock Text="Add music"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarNew}" Click="MusicFolder_Click">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Folder24" Margin="0,0,12,0"/><TextBlock Text="Music folder"/></StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Margin="0,18,0,0">
                            <Button Style="{StaticResource SidebarNew}" Click="RecentlyAdded_Click" ToolTip="Recently Added"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,12,0"/><TextBlock Text="Recently Added"/></StackPanel></Button>
                            <Button Style="{StaticResource SidebarNew}" Click="History_Click" ToolTip="Recently Played"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Play24" Margin="0,0,12,0"/><TextBlock Text="Recently Played"/></StackPanel></Button>
                            <Button Style="{StaticResource SidebarNew}" Click="Stats_Click" ToolTip="Most Played"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Grid24" Margin="0,0,12,0"/><TextBlock Text="Most Played"/></StackPanel></Button>
                            <Button Style="{StaticResource SidebarNew}" Click="SurpriseMe_Click" ToolTip="Surprise me"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowShuffle24" Margin="0,0,12,0"/><TextBlock Text="Surprise me"/></StackPanel></Button>
                            <Button Style="{StaticResource SidebarNew}" Click="Unplayed_Click" ToolTip="Unplayed"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="MusicNote224" Margin="0,0,12,0"/><TextBlock Text="Unplayed"/></StackPanel></Button>
                            <Button Style="{StaticResource SidebarNew}" Click="Duplicates_Click" ToolTip="Possible duplicates"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="TextBulletListSquare24" Margin="0,0,12,0"/><TextBlock Text="Possible duplicates"/></StackPanel></Button>
                            <TextBlock Text="Playlists" Foreground="{StaticResource WaveMuted}" FontSize="12" Margin="8,0,0,8"/>
                            <ListBox x:Name="PlaylistList" ItemContainerStyle="{StaticResource PlaylistItemStyle}" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="PlaylistList_SelectionChanged" PreviewMouseRightButtonUp="PlaylistList_PreviewMouseRightButtonUp" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,4,2,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="6" ClipToBounds="True" Background="#1A2232">
                                                <Grid>
                                                    <ui:SymbolIcon Symbol="MusicNote224" Foreground="#B6C2D8" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Playlist.Name}" FontWeight="SemiBold" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Playlist.SongIds.Count, StringFormat={}{0} songs}" FontSize="10" Foreground="{StaticResource WaveMuted}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- center -->
                <ScrollViewer x:Name="CenterScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" PreviewMouseWheel="CenterScrollViewer_PreviewMouseWheel">
                    <ScrollViewer.Resources>
                        <DataTemplate x:Key="UnifiedMusicResultTemplate">
                            <Button Click="UnifiedResult_Open_Click" Background="#1A202B" Foreground="#F2F5FB"
                                    BorderBrush="#303848" BorderThickness="1" Padding="8" Margin="0,0,0,5"
                                    HorizontalContentAlignment="Stretch" ToolTip="Open or play this result">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="5" ClipToBounds="True"
                                            Background="#252B38" Margin="0,0,10,0">
                                        <Image Source="{Binding Artwork}" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{StaticResource WaveMuted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>

                        <DataTemplate x:Key="ProviderSearchResultTemplate">
                            <Border Background="#1A202B" BorderBrush="#303848" BorderThickness="1" Padding="8" CornerRadius="7" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="92"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Click="UnifiedResult_Open_Click" Background="Transparent" BorderThickness="0"
                                            Foreground="#F2F5FB" HorizontalContentAlignment="Stretch" ToolTip="Open this track on its music service">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="48" Height="34" CornerRadius="5" ClipToBounds="True"
                                                    Background="#252B38" Margin="0,0,9,0">
                                                <Image Source="{Binding Song.ArtworkUrl}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{StaticResource WaveMuted}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                    <Button Grid.Column="1" Content="Download" Click="ProviderResult_Download_Click" Margin="8,0,0,0"
                                            ToolTip="Import audio only if you own it or have permission"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ScrollViewer.Resources>

                    <StackPanel>

                        <!-- Single search surface for library tracks and saved provider links. -->
                        <Border x:Name="UnifiedSearchPanel" Visibility="Collapsed" Background="{StaticResource WavePanel}"
                                BorderBrush="{StaticResource WaveStroke}" BorderThickness="1" CornerRadius="14"
                                Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="Clear search" Click="UnifiedClearSearch_Click"
                                            Padding="10,5" ToolTip="Return to your library"/>
                                    <StackPanel>
                                        <TextBlock Text="Search results" FontSize="22" FontWeight="Bold"/>
                                        <TextBlock x:Name="UnifiedQueryHeading" Foreground="{StaticResource WaveMuted}" FontSize="12"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="One search for offline music, YouTube and SoundCloud via yt-dlp, and Spotify tracks via wolfXspotify API."
                                           Foreground="{StaticResource WaveMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <DockPanel Margin="0,0,0,7">
                                    <TextBlock Text="Offline" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="OfflineSearchCount" DockPanel.Dock="Right" Foreground="{StaticResource WaveMuted}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl x:Name="OfflineSearchResults" ItemTemplate="{StaticResource UnifiedMusicResultTemplate}" Margin="0,0,0,14"/>
                                <Separator Background="#2C3442" Margin="0,0,0,12"/>
                                <DockPanel Margin="0,0,0,7" LastChildFill="False">
                                    <Button DockPanel.Dock="Right" Content="Search YouTube" Click="YouTubeSearch_Click"
                                            Padding="10,5" ToolTip="Search YouTube within Waveify using yt-dlp"/>
                                    <TextBlock Text="YouTube" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="YoutubeSearchCount" Foreground="{StaticResource WaveMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl x:Name="YoutubeSearchResults" ItemTemplate="{StaticResource ProviderSearchResultTemplate}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="YouTubeSearchStatus" Text="Type a query to search YouTube using yt-dlp."
                                           FontSize="11" Foreground="{StaticResource WaveMuted}" Margin="0,0,0,14" TextWrapping="Wrap"/>
                                <Separator Background="#2C3442" Margin="0,0,0,12"/>
                                <DockPanel Margin="0,0,0,7" LastChildFill="False">
                                    <Button DockPanel.Dock="Right" Content="Search SoundCloud" Click="SoundCloudSearch_Click"
                                            Padding="10,5" ToolTip="Search SoundCloud within Waveify using yt-dlp"/>
                                    <TextBlock Text="SoundCloud" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SoundcloudSearchCount" Foreground="{StaticResource WaveMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl x:Name="SoundcloudSearchResults" ItemTemplate="{StaticResource ProviderSearchResultTemplate}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="SoundCloudSearchStatus" Text="Type a query to search SoundCloud using yt-dlp."
                                           FontSize="11" Foreground="{StaticResource WaveMuted}" Margin="0,0,0,14" TextWrapping="Wrap"/>
                                <Separator Background="#2C3442" Margin="0,0,0,12"/>
                                <DockPanel Margin="0,0,0,7" LastChildFill="False">
                                    <Button DockPanel.Dock="Right" Content="Search Spotify" Click="SpotifySearch_Click"
                                            Padding="10,5" ToolTip="Search Spotify tracks directly using wolfXspotify API"/>
                                    <TextBlock Text="Spotify" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SpotifySearchCount" Foreground="{StaticResource WaveMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl x:Name="SpotifySearchResults" ItemTemplate="{StaticResource ProviderSearchResultTemplate}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="SpotifySearchStatus" Text="Type a query to search Spotify tracks using wolfXspotify API."
                                           FontSize="11" Foreground="{StaticResource WaveMuted}" Margin="0,0,0,14" TextWrapping="Wrap"/>
                                <Border Background="#1A202B" BorderBrush="#303848" BorderThickness="1" CornerRadius="10"
                                        Padding="12" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Import a music link" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                        <TextBlock Text="Copy a result URL from a service. Preview public details or download audio you are authorized to save."
                                                   TextWrapping="Wrap" Foreground="{StaticResource WaveMuted}" FontSize="11" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="UnifiedUrlBox" Grid.Column="0" Height="33" VerticalContentAlignment="Center"
                                                     Padding="8,4" Margin="0,0,6,0" ToolTip="Paste a public HTTPS music link"/>
                                            <Button Grid.Column="1" Content="Paste" Click="UnifiedPasteLink_Click" Margin="0,0,5,0"/>
                                            <Button Grid.Column="2" Content="Preview" Click="UnifiedPreview_Click" Margin="0,0,5,0"/>
                                            <Button x:Name="UnifiedDownloadButton" Grid.Column="3" Content="Download" Click="UnifiedDownload_Click"
                                                    ToolTip="Import authorized music using the installed tools"/>
                                        </Grid>
                                        <TextBlock x:Name="UnifiedStatus" Foreground="{StaticResource WaveMuted}" TextWrapping="Wrap"
                                                   FontSize="11" Margin="0,8,0,0" Text="YouTube and SoundCloud use yt-dlp. Spotify search uses the wolfXspotify API without Python."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="BrowseContentPanel">
                        <Border Height="300" CornerRadius="12" ClipToBounds="True" Margin="0,0,0,18">
                            <Grid>
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F13C4A" Offset="0"/>
                                            <GradientStop Color="#B02C51" Offset="0.55"/>
                                            <GradientStop Color="#431D40" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Path Fill="#3F6F2337" Data="M0,250 C220,270 350,225 480,190 C610,133 702,145 790,102 C873,70 933,67 980,87 L980,294 0,294 Z" Stretch="Fill"/>
                                <Path Fill="#5A70233B" Data="M0,288 C210,277 365,251 499,223 C630,175 710,207 822,166 C888,143 947,155 980,171 L980,294 0,294 Z" Stretch="Fill"/>
                                <Grid Margin="36,18,14,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="MADE FOR YOU" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="WAVEIFY MIX" FontSize="54" TextTrimming="CharacterEllipsis" FontWeight="Black" FontStyle="Italic" Margin="0,6,0,18"/>
                                        <TextBlock Text="Your music, your way" FontSize="17"/>
                                        <TextBlock x:Name="Heading" Text="k" FontSize="34" FontWeight="Bold" Margin="0,6,0,14"/>
                                        <DockPanel LastChildFill="False">
                                            <Button DockPanel.Dock="Left" Style="{StaticResource HeroPlayButton}" Click="PlayAll_Click" ToolTip="Play all"><ui:SymbolIcon Symbol="Play24" Foreground="#12161F"/></Button>
                                            <TextBlock x:Name="SubHeading" Text="2 tracks · Double-click a local track to play" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Margin="0,-4,4,-4" Width="340" HorizontalAlignment="Right" CornerRadius="0" BorderThickness="1" BorderBrush="#52FFFFFF" ClipToBounds="True" Background="#26FFFFFF">
                                        <Grid>
                                             <Image Source="{Binding ElementName=NowArtwork,Path=Source}" Stretch="UniformToFill"/>
                                             <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#22AC244A" Offset="0"/><GradientStop Color="#A52F1732" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                         </Grid>
                                     </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <DockPanel Margin="8,0,8,12"><Button DockPanel.Dock="Right" Content="See all →" Click="SeeAll_Click" FontSize="13"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="Hottest in your library" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="  Local releases" Foreground="{StaticResource WaveMuted}" VerticalAlignment="Bottom" FontSize="13" Margin="1,0,0,1"/>
                            </StackPanel></DockPanel>

                        <ItemsControl ItemsSource="{Binding ElementName=SongList, Path=ItemsSource}" Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="186" Background="#1B202B" BorderBrush="#313746" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0" Padding="9" MouseRightButtonUp="SongCard_MouseRightButtonUp">
                                        <StackPanel>
                                            <Border Width="166" Height="126" CornerRadius="7" ClipToBounds="True" Background="#1F2738">
                                                <Grid>
                                                    <Image Source="{Binding Artwork}" Stretch="UniformToFill"/>
                                                    <Button Click="SongCard_Play_Click" Width="38" Height="38" Style="{StaticResource CardPlayButton}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Play">
                                                        <ui:SymbolIcon Symbol="Play24" Foreground="White"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11.5" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{StaticResource WaveMuted}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel x:Name="HomeShelves" Visibility="Collapsed">
                            <ItemsControl x:Name="ArtistShelves">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,18">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Margin="8,0,0,8"/>
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding Tracks}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="186" Background="#1B202B" BorderBrush="#313746" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0" Padding="9" MouseLeftButtonDown="ShelfTrack_MouseLeftButtonDown" MouseRightButtonUp="SongCard_MouseRightButtonUp">
                                                                <StackPanel>
                                                                    <Border Width="166" Height="126" CornerRadius="7" ClipToBounds="True" Background="#1F2738"><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Border>
                                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11.5" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{StaticResource WaveMuted}" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl x:Name="AlbumShelves" ItemTemplate="{Binding ElementName=ArtistShelves, Path=ItemTemplate}"/>
                            <ItemsControl x:Name="GenreShelves">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,18">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Margin="8,0,0,8"/>
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding Tracks}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="186" Background="#1B202B" BorderBrush="#313746" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0" Padding="9" MouseLeftButtonDown="ShelfTrack_MouseLeftButtonDown" MouseRightButtonUp="SongCard_MouseRightButtonUp">
                                                                <StackPanel>
                                                                    <Border Width="166" Height="126" CornerRadius="7" ClipToBounds="True" Background="#1F2738"><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Border>
                                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11.5" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{StaticResource WaveMuted}" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <DockPanel Margin="8,4,8,8">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="Songs" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="  " />
                                <TextBlock Text="{Binding ElementName=SongList, Path=Items.Count, StringFormat={}{0} tracks}" Foreground="{StaticResource WaveMuted}" FontSize="13" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ComboBox x:Name="SortBox" Width="135" Margin="0,0,8,0" SelectionChanged="SortBox_SelectionChanged"><ComboBoxItem Content="Playlist order"/><ComboBoxItem Content="Title"/><ComboBoxItem Content="Artist"/><ComboBoxItem Content="Date added"/></ComboBox>
                                <Button Style="{StaticResource SmallRoundButton}" ToolTip="List view" Click="ListView_Click"><ui:SymbolIcon Symbol="TextBulletListSquare24"/></Button>
                                <Button Style="{StaticResource SmallRoundButton}" ToolTip="Grid view" Click="GridView_Click"><ui:SymbolIcon Symbol="Grid24"/></Button>
                                <Border Width="210" Height="34" Background="#20242F" BorderBrush="#313746" BorderThickness="1" CornerRadius="12" Margin="10,0,0,0">
                                    <DockPanel Margin="12,0">
                                        <ui:SymbolIcon Symbol="Search24" Foreground="#8390A7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Search in library..." Foreground="#8390A7" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer x:Name="SongGridScrollViewer" Height="290" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly">
                        <ItemsControl x:Name="SongGrid" ItemsSource="{Binding ElementName=SongList,Path=ItemsSource}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="150" Height="70" Margin="5" Click="SongCard_Play_Click"><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </ScrollViewer>
                        <WrapPanel Margin="8,2"><TextBox x:Name="ArtistFilter" Width="90" ToolTip="Artist filter"/><TextBox x:Name="AlbumFilter" Width="90" ToolTip="Album filter"/><TextBox x:Name="GenreFilter" Width="90" ToolTip="Genre filter"/><TextBox x:Name="YearFilter" Width="55" ToolTip="Year"/><CheckBox x:Name="LikedFilter" Content="Liked"/><CheckBox x:Name="LocalFilter" Content="Local"/><Button Content="Filter" Click="ApplyFilters_Click"/><Button Content="Reset" Click="ResetFilters_Click"/></WrapPanel>
                        <ListView x:Name="SongList" Height="290" AllowDrop="True" ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewMouseLeftButtonDown="SongList_PreviewMouseLeftButtonDown" MouseMove="SongList_MouseMove" Drop="SongList_Drop" ContextMenuOpening="SongList_ContextMenuOpening" PreviewMouseRightButtonDown="SongList_PreviewMouseRightButtonDown" Background="Transparent" BorderThickness="0" Foreground="White" MouseDoubleClick="SongList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource MusicTrackRow}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="#" Width="42" DisplayMemberBinding="{Binding Index}"/>
                                    <GridViewColumn Header="Title" Width="300">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Border Width="34" Height="34" CornerRadius="5" ClipToBounds="True" Background="#1A2232"><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Border>
                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                                        <TextBlock Text="{Binding Artist}" FontSize="10.5" Foreground="{StaticResource WaveMuted}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Album" Width="150" DisplayMemberBinding="{Binding Album}"/>
                                    <GridViewColumn Header="Date added" Width="120" DisplayMemberBinding="{Binding DateAdded}"/>
                                    <GridViewColumn Header="◷" Width="75" DisplayMemberBinding="{Binding Duration}"/>
                                    <GridViewColumn Header="▼" Width="28"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- right now playing -->
                <Border Grid.Column="2" Background="{StaticResource WavePanel}" BorderBrush="{StaticResource WaveStroke}" BorderThickness="1" CornerRadius="16" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Now Playing" FontSize="19" FontWeight="Bold"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="MusicNote224" Foreground="#D6DDED" Margin="0,0,10,0"/>
                                <TextBlock Text="⋮" Foreground="#D6DDED" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1" Height="272" Background="#192131" CornerRadius="8" BorderBrush="#3C465B" BorderThickness="1" ClipToBounds="True">
                            <Image x:Name="NowArtwork" Stretch="UniformToFill"/>
                        </Border>

                        <StackPanel Grid.Row="2" Margin="0,15,0,0">
                            <TextBlock x:Name="NowTitle" Text="Nothing playing" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="72"/>
                            <TextBlock x:Name="NowArtist" Text="Pick a track from your library" FontSize="13" Foreground="{StaticResource WaveMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,12,0,6">
                                <TextBlock x:Name="Elapsed" Text="0:00" DockPanel.Dock="Left" FontSize="12" Foreground="#D7DCE8"/>
                                <TextBlock x:Name="Total" Text="0:00" DockPanel.Dock="Right" FontSize="12" Foreground="#D7DCE8"/>
                            </DockPanel>
                            <Slider x:Name="Progress" Style="{StaticResource AccentSeekBar}" Minimum="0" Maximum="100" ValueChanged="Progress_ValueChanged" PreviewMouseDown="Progress_PreviewMouseDown" PreviewMouseUp="Progress_PreviewMouseUp" ToolTip="Drag to seek"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,10">
                                <Button x:Name="ShuffleButton" Style="{StaticResource PlayerButton}" Click="Shuffle_Click" ToolTip="Shuffle"><ui:SymbolIcon Symbol="ArrowShuffle24"/></Button>
                                <Button Style="{StaticResource PlayerButton}" Click="Previous_Click" ToolTip="Previous"><ui:SymbolIcon Symbol="Previous24"/></Button>
                                <Button Style="{StaticResource LargePlayButton}" Click="PlayPause_Click" ToolTip="Play / Pause"><ui:SymbolIcon x:Name="PlayGlyph" Symbol="Play24" FontSize="19" Foreground="#10141D" Margin="1,0,0,0"/></Button>
                                <Button Style="{StaticResource PlayerButton}" Click="Next_Click" ToolTip="Next"><ui:SymbolIcon Symbol="Next24"/></Button>
                                <Button x:Name="RepeatButton" Style="{StaticResource PlayerButton}" Click="Repeat_Click" Content="↻" ToolTip="Repeat"/>
                            </StackPanel>
                        </StackPanel>

                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><StackPanel><StackPanel x:Name="EqualizerPanel" Margin="0,14,0,10">
                                <DockPanel Margin="0,0,0,8"><TextBlock Text="Equalizer" FontWeight="SemiBold" FontSize="14"/><CheckBox x:Name="EqualizerEnabled" DockPanel.Dock="Right" HorizontalAlignment="Right" IsChecked="True" ToolTip="Enable equalizer" Checked="EqualizerEnabled_Changed" Unchecked="EqualizerEnabled_Changed"/></DockPanel>
                                <ComboBox x:Name="EqualizerPreset" SelectedIndex="0" Margin="0,0,0,7" SelectionChanged="EqualizerPreset_SelectionChanged" ToolTip="Equalizer preset"><ComboBoxItem Content="Flat"/><ComboBoxItem Content="Rock"/><ComboBoxItem Content="Vocal"/><ComboBoxItem Content="Electronic"/></ComboBox>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center"><Slider x:Name="EqualizerSlider" Orientation="Vertical" Height="65" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqualizerSlider_ValueChanged" ToolTip="Bass"/><TextBlock Text="Bass" HorizontalAlignment="Center"/></StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center"><Slider x:Name="MidSlider" Orientation="Vertical" Height="65" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqualizerSlider_ValueChanged" ToolTip="Mid"/><TextBlock Text="Mid" HorizontalAlignment="Center"/></StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center"><Slider x:Name="TrebleSlider" Orientation="Vertical" Height="65" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqualizerSlider_ValueChanged" ToolTip="Treble"/><TextBlock Text="Treble" HorizontalAlignment="Center"/></StackPanel>
                                </Grid>
                            </StackPanel><StackPanel x:Name="QueuePanel" Margin="0,8,0,0">
                            <Border Height="1" Background="#212A39" Margin="0,0,0,12"/>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Up Next" FontSize="14" FontWeight="Bold"/>
                                <Button DockPanel.Dock="Right" Content="Clear" Click="ClearQueue_Click" FontSize="12"/>
                            </DockPanel>
                            <ListView x:Name="QueueList" Height="190" Background="Transparent" BorderThickness="0" MouseDoubleClick="QueueSong_DoubleClick"><ListView.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,15" MouseRightButtonUp="SongCard_MouseRightButtonUp">
                                            <Border DockPanel.Dock="Left" Width="43" Height="43" CornerRadius="5" ClipToBounds="True" Margin="0,0,10,0"><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Border>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" VerticalAlignment="Center" Foreground="#D7DCE8" FontSize="12"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                                <TextBlock Text="{Binding Artist}" FontSize="10.5" Foreground="{StaticResource WaveMuted}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal"><Button Content="Move up" Click="QueueMoveUp_Click"/><Button Content="Remove" Click="QueueRemove_Click"/></StackPanel>
                        </StackPanel></StackPanel></ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- bottom player -->
            <Border Grid.Row="2" Margin="0,2,0,0" CornerRadius="16" Background="#151A23" BorderBrush="#2B303D" BorderThickness="1" Padding="18,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="8" ClipToBounds="True" Background="#1B2333"><Image Source="{Binding ElementName=NowArtwork,Path=Source}" Stretch="UniformToFill"/></Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ElementName=NowTitle,Path=Text}" FontSize="13" FontWeight="Bold" MaxWidth="230" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ElementName=NowArtist,Path=Text}" FontSize="11" Foreground="{StaticResource WaveMuted}" MaxWidth="230" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="BottomLikeButton" Style="{StaticResource PlayerButton}" Width="34" Height="34" Margin="14,0,0,0" Click="CurrentLike_Click" ToolTip="Like current song">
                            <ui:SymbolIcon x:Name="BottomLikeIcon" Symbol="Heart24"/>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10">
                            <Button x:Name="BottomShuffleButton" Style="{StaticResource PlayerButton}" Click="Shuffle_Click" ToolTip="Shuffle"><ui:SymbolIcon Symbol="ArrowShuffle24"/></Button>
                            <Button Style="{StaticResource PlayerButton}" Click="Previous_Click" ToolTip="Previous"><ui:SymbolIcon Symbol="Previous24"/></Button>
                            <Button Style="{StaticResource LargePlayButton}" Click="PlayPause_Click" ToolTip="Play / Pause"><ui:SymbolIcon Symbol="{Binding ElementName=PlayGlyph,Path=Symbol}" FontSize="19" Foreground="#10141D" Margin="1,0,0,0"/></Button>
                            <Button Style="{StaticResource PlayerButton}" Click="Next_Click" ToolTip="Next"><ui:SymbolIcon Symbol="Next24"/></Button>
                            <Button Style="{StaticResource PlayerButton}" Click="Repeat_Click" ToolTip="Repeat" Content="{Binding ElementName=RepeatButton,Path=Content}"/>
                        </StackPanel>
                        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ElementName=Elapsed,Path=Text}" Foreground="#D7DCE8" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                            <Slider x:Name="BottomProgress" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,1" Style="{StaticResource AccentSeekBar}" Minimum="0" Maximum="100" Value="{Binding ElementName=Progress,Path=Value,Mode=TwoWay}" ValueChanged="Progress_ValueChanged" PreviewMouseDown="Progress_PreviewMouseDown" PreviewMouseUp="Progress_PreviewMouseUp" ToolTip="Drag to seek"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=Total,Path=Text}" Foreground="#D7DCE8" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource PlayerButton}" ToolTip="Queue" Click="Queue_Click"><ui:SymbolIcon Symbol="TextBulletListSquare24"/></Button>
                        
                        <Button x:Name="DevicePickerButton" Click="DevicePickerButton_Click" Style="{StaticResource PlayerButton}" ToolTip="Choose output device"><ui:SymbolIcon Symbol="Headphones24"/></Button>
                        <Border x:Name="OutputPickerHost" Background="#1A202B" CornerRadius="10" Padding="4" Visibility="Collapsed" Margin="6,0,6,0"><ComboBox x:Name="OutputDeviceCombo" Width="170" ToolTip="Select output device" SelectionChanged="OutputDeviceCombo_SelectionChanged"/></Border>
                        <Button Style="{StaticResource PlayerButton}" Click="RefreshOutputs_Click" ToolTip="Refresh audio devices"><ui:SymbolIcon Symbol="Speaker224"/></Button>
                        <Slider x:Name="Volume" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="1" Value="0.75" Width="115" Margin="8,0,0,0" ToolTip="Volume" ValueChanged="Volume_ValueChanged"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
